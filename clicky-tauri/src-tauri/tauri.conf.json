{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clicky-tauri",
  "version": "0.1.0",
  "identifier": "com.svr01.clicky-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "clicky-tauri",
        "width": 350,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "url": "/"
      },
      {
        "label": "overlay",
        "title": "Clicky Overlay",
        "fullscreen": false,
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "/?overlay=true"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
